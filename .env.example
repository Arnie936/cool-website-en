# Copy to .env in your WEBSITE PROJECT root, not the public build folder.
# Fill only the selected provider. Images need no external API credentials.
# Video provider: higgsfield (default) | kie
COOL_WEBSITE_VIDEO_PROVIDER=higgsfield

# Official Higgsfield API (default video provider).
# No Higgsfield account yet? Sign up here: https://higgsfield.ai/s/mcp-arnold-oberleiter-ecZvus
# Then create API keys at https://console.higgsfield.ai/
# These are API credentials, not a browser session or CLI login token.
HF_API_KEY_ID=your_higgsfield_key_id
HF_API_KEY_SECRET=your_higgsfield_key_secret

# kie.ai video generation (second option: set COOL_WEBSITE_VIDEO_PROVIDER=kie)
KIE_AI_API_KEY=your_kie_api_key
